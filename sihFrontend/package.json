{
  "name": "jagruk-swadesh-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix server",
    "dev:fastapi": "python -m uvicorn fastapi_server:server --reload --host 127.0.0.1 --port 8000 --app-dir ..",
    "dev": "concurrently --kill-others-on-fail --names \"🔐 EXPRESS,🧠 FASTAPI,⚛️  VITE\" --prefix-colors \"yellow.bold,cyan.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:fastapi\" \"npm run dev:frontend\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.2"
  }
}
